# nginx 反向代理模板 —— TLS 终止 + 转发业务后端
# 复制到 /etc/nginx/sites-available/zd-backend.conf 并按域名/证书修改。
# 本模板未在真实服务器验证，上线前需 nginx -t 实测。

server {
    listen 443 ssl http2;
    server_name zd.example.com;          # 改为正式域名

    ssl_certificate     /etc/nginx/certs/zd.example.com.crt;
    ssl_certificate_key /etc/nginx/certs/zd.example.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:zd_ssl:10m;

    # 上传/报告截图体积上限，按需调整
    client_max_body_size 20m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    # /health 不暴露公网：仅监控网段可访问（可按需删除该 location 改为全开放）
    location = /health {
        allow 10.0.0.0/8;               # 改为监控/运维网段
        deny all;
        proxy_pass http://127.0.0.1:8000;
    }
}

server {
    listen 80;
    server_name zd.example.com;
    return 301 https://$host$request_uri;
}
