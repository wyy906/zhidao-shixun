# 生产环境变量模板 —— 复制到 /etc/zd-backend/backend.env 并逐项填写
# 权限必须 600，属主 zd-backend；真实值不入 Git。
# 填完后在业务服务器执行：
#   python scripts/backend_preflight.py --env-file /etc/zd-backend/backend.env
# 要求 FAIL=0 才能上线（WARN 项需负责人确认接受）。

# ===== 应用 =====
APP_ENV=production
DEBUG=false

# ===== 服务 =====
# uvicorn 只绑定本机回环，TLS 由反向代理终止
HOST=127.0.0.1
PORT=8000
# 写明确的正式域名，禁止 *
CORS_ORIGINS=["https://zd.example.com"]

# ===== 数据库（生产建议 PostgreSQL）=====
DATABASE_URL=postgresql+psycopg://zd_user:CHANGE_ME@127.0.0.1:5432/zd_shixun
# 生产必须留空/false：先执行 alembic upgrade head
DB_AUTO_CREATE=

# ===== 首次启动引导账号（仅在 users 表为空时创建一次）=====
ADMIN_USERNAME=admin
# 至少 12 字符，禁止默认/弱口令；创建后立即在系统内修改
ADMIN_PASSWORD=CHANGE-ME-at-least-12-chars

# ===== JWT =====
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE-ME-random-32-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 公开注册 =====
ALLOW_PUBLIC_REGISTER=false

# ===== AI（可选，三项需同时填写，否则整组忽略）=====
AI_API_BASE_URL=
AI_API_KEY=
AI_VISION_MODEL=

# ===== NVIDIA NIM（可选备选，仅在 AI_* 全空时生效）=====
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=

# ===== 代码执行沙箱 =====
# 未部署执行节点前保持 false；上线执行节点后改为 true 并填写以下三项
CODE_EXECUTION_ENABLED=false
# 例如 https://10.0.0.20:8443（执行节点内网地址，生产必须 HTTPS）
SANDBOX_MANAGER_URL=
# 与执行节点 ZD_SANDBOX_TOKEN 一致，长度 >= 32
SANDBOX_MANAGER_TOKEN=
# 固定 CA 与双向 TLS 客户端证书（生产建议全部配置）
SANDBOX_MANAGER_CA_FILE=/etc/zd-backend/certs/ca.crt
SANDBOX_MANAGER_CLIENT_CERT=/etc/zd-backend/certs/client.crt
SANDBOX_MANAGER_CLIENT_KEY=/etc/zd-backend/certs/client.key
SANDBOX_ALLOW_INSECURE_HTTP=false
SANDBOX_SYNC_WAIT_SECONDS=20
CODE_RUN_TIMEOUT_SECONDS=10
CODE_MAX_INPUT_BYTES=65536
CODE_MAX_OUTPUT_BYTES=65536
CODE_MAX_CONCURRENT_REQUESTS=8
CODE_MAX_CONCURRENT_PER_USER=1
