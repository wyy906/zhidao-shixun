[Unit]
Description=ZhiDao Sandbox Manager (dedicated Docker execution node)
Documentation=file:///opt/zd-sandbox/SANDBOX_DEPLOYMENT.md
# 必须与业务服务器分离部署；排除与业务后端同机运行
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
# 专用非 root 账号，仅加入 docker 组。
# Docker Socket 只对本进程可见，绝不挂载进学生代码执行容器。
User=zd-sandbox
Group=zd-sandbox
EnvironmentFile=/etc/zd-sandbox/manager.env
WorkingDirectory=/opt/zd-sandbox
ExecStart=/opt/zd-sandbox/venv/bin/python -m sandbox_manager
Restart=on-failure
RestartSec=3
# 加固：管理器进程本身也不需要写系统目录
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run /var/run
LimitNOFILE=4096

# 网络暴露要求：
#   1) ZD_SANDBOX_HOST 默认 127.0.0.1（由本机反向代理终止 TLS），
#      跨机部署时必须只绑定受防火墙保护的内网地址；
#   2) 防火墙只允许业务后端服务器访问 8443，禁止对学生网段/公网开放；
#   3) 业务后端是唯一允许调用管理接口的服务，不得把接口暴露给学生或桌面端。

[Install]
WantedBy=multi-user.target
