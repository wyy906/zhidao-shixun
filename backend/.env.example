# ===== 应用配置 =====
APP_NAME=智导实训
APP_ENV=development
DEBUG=true

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ===== 数据库 =====
# 开发环境用 SQLite（相对路径基于 backend/ 目录）
# 生产可换 PostgreSQL：postgresql+psycopg://user:pass@localhost/dbname
DATABASE_URL=sqlite:///./zd_shixun.db
# 启动建表策略：留空 = 仅 development 自动 create_all；
# 生产请保持留空/false，并先执行 `alembic upgrade head`
DB_AUTO_CREATE=

# ===== 首次启动引导账号 =====
# 仅在 users 表为空时创建一次，之后修改此处不会影响已有账号
ADMIN_USERNAME=admin
# 占位值，部署前必须改掉（不要直接使用本文件里的默认值）
ADMIN_PASSWORD=change-me-please

# ===== JWT =====
# 生产环境必须替换为随机长字符串，否则应用会拒绝启动
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 公开注册 =====
ALLOW_PUBLIC_REGISTER=false

# ===== AI 多模态视觉模型（OpenAI 兼容接口）=====
# 三项全部留空时，AI 屏幕指导只走教程关键词快路径，不调用视觉模型
AI_API_BASE_URL=
AI_API_KEY=
AI_VISION_MODEL=
# 错误诊断（/api/v1/ai/diagnose）复用同一个模型做文本调用；模型不可用时回退到步骤信息

# ===== NVIDIA NIM（OpenAI 兼容，可选，待负责人确认）=====
# 说明：仅当上面 AI_* 三项全部为空时才会启用，不改变默认 AI 服务商；
#       三项必须同时填写，否则整组忽略。
# Base URL 以 NVIDIA 官方文档为准（NIM 端点，OpenAI Chat Completions 兼容）：
#   https://integrate.api.nvidia.com/v1
# 模型 ID 必须从 NVIDIA 官方模型页选择支持视觉/多模态的模型，不要凭猜测填写。
# 本账号 2026-11-13 实测可用示例：nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# （其他账号可用性以官方模型页为准）
# 密钥只放在本地 backend/.env，禁止提交或写入文档。
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=

# ===== 代码执行沙箱（学生代码只在独立 Linux 执行节点运行）=====
# 总开关：false 时 POST /code/run 直接返回 503（不会回退本机执行）
CODE_EXECUTION_ENABLED=true
# 独立沙箱管理器地址，例如 https://10.0.0.20:8443
# 留空 = 未部署执行节点，所有代码执行请求一律拒绝
SANDBOX_MANAGER_URL=
# 管理接口令牌（与执行节点 ZD_SANDBOX_TOKEN 一致）
SANDBOX_MANAGER_TOKEN=
# 内网 TLS / 双向 TLS（推荐；不允许关闭证书校验）
SANDBOX_MANAGER_CA_FILE=
SANDBOX_MANAGER_CLIENT_CERT=
SANDBOX_MANAGER_CLIENT_KEY=
# 仅本机回环开发时允许明文 HTTP；非回环地址必须使用 HTTPS
SANDBOX_ALLOW_INSECURE_HTTP=false
# 同步兼容接口最长等待（秒）
SANDBOX_SYNC_WAIT_SECONDS=20
# 学生不可通过请求参数突破以下上限
CODE_RUN_TIMEOUT_SECONDS=10
CODE_MAX_INPUT_BYTES=65536
CODE_MAX_OUTPUT_BYTES=65536
CODE_MAX_CONCURRENT_REQUESTS=8
CODE_MAX_CONCURRENT_PER_USER=1

