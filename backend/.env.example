# ===== 应用配置 =====
APP_NAME=智导实训
APP_ENV=development
DEBUG=true

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ===== 数据库 =====
# 开发环境用 SQLite（相对路径基于 backend/ 目录）
# 生产可换 PostgreSQL：postgresql+psycopg://user:pass@localhost/dbname
DATABASE_URL=sqlite:///./zd_shixun.db

# ===== 首次启动引导账号 =====
# 仅在 users 表为空时创建一次，之后修改此处不会影响已有账号
ADMIN_USERNAME=admin
# 占位值，部署前必须改掉（不要直接使用本文件里的默认值）
ADMIN_PASSWORD=change-me-please

# ===== JWT =====
# 生产环境必须替换为随机长字符串，否则应用会拒绝启动
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 公开注册 =====
ALLOW_PUBLIC_REGISTER=false

# ===== AI 多模态视觉模型（OpenAI 兼容接口）=====
# 三项全部留空时，AI 屏幕指导只走教程关键词快路径，不调用视觉模型
AI_API_BASE_URL=
AI_API_KEY=
AI_VISION_MODEL=
