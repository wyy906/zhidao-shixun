# 智导实训 V2 环境变量示例。
# 使用方法：复制本文件为 .env 后按需修改；真实 .env 已被 .gitignore 忽略，禁止提交。
# 全部变量使用 ZD_ 前缀。本项目不内置任何默认账号 / 密码 / 密钥。

# ===== 服务端（server/）=====
# development | production | test
ZD_APP_ENV=development
ZD_DEBUG=true
ZD_HOST=127.0.0.1
ZD_PORT=8000
ZD_LOG_LEVEL=INFO
# 允许跨域的前端来源（JSON 数组格式）
ZD_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 数据库（V2-03 起真正使用；初期 SQLite）
ZD_DATABASE_URL=sqlite:///./zhidao.db

# ===== 独立 Docker 执行服务（V2-04B；仅执行服务进程读取，业务进程不加载 Docker SDK）=====
# 调用令牌：浏览器永不持有；为空时执行服务拒绝启动（fail-closed）
# ZD_EXECUTOR_TOKEN=
# ZD_EXECUTOR_BIND_HOST=127.0.0.1
# ZD_EXECUTOR_BIND_PORT=8101
# 固定执行镜像（服务端固定生成，用户不可指定）
# ZD_EXECUTOR_IMAGE_TAG=python:3.12-slim
# 批准的镜像 digest：为空（executor_image_lock.json approval_status=pending）时拒绝一切执行
# ZD_EXECUTOR_IMAGE_DIGEST=
# ZD_EXECUTOR_RECORDS_PATH=data/executor_records.jsonl

# ===== Windows 助手（desktop/）=====
ZD_API_BASE_URL=http://127.0.0.1:8000
ZD_REQUEST_TIMEOUT_SECONDS=3

# ===== AI 模型（V2-07 起使用，当前预留）=====
# 密钥只从环境变量读取，禁止写入代码或提交仓库
# ZD_AI_API_BASE_URL=
# ZD_AI_API_KEY=
# ZD_AI_VISION_MODEL=
