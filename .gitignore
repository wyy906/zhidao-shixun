# ===========================================
# 智导实训 · Git 忽略规则
# 原则：密钥、真实数据、依赖、构建产物、大体积素材一律不入库
# ===========================================

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# Python
__pycache__/
*.py[cod]
*.pyd
.Python
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
dist/
build/
.next/
.nuxt/
.output/
coverage/
.vite/
*.tsbuildinfo
# vite.config.ts 的编译产物（由 tsc -b 生成，不应入库）
frontend/vite.config.js
frontend/vite.config.d.ts

# Local databases and user data
*.sqlite
*.sqlite3
*.db
data/private/
uploads/
user_uploads/

# Logs and runtime files
*.log
logs/
*.pid
*.seed

# Local review snapshot (含 .env 副本与真实数据库，仅保留在本地)
ai_review/

# 桌面端运行期截图/调试图
.screenshots/

# 调试用截图（docs 下仅保留文字说明，图片含个人桌面内容）
docs/*.png

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo
